# ============================================
# EasyAgenda+ - Frontend Environment Variables
# ============================================

BACKEND_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
AUTH_BFF_UPSTREAM_TIMEOUT_MS=20000
# Origem do backend liberada no connect-src do CSP (next.config.js). Opcional:
# sem ela vale o backend atual no Render (https://easybarber-backend.onrender.com).
BACKEND_ORIGIN=
NEXT_PUBLIC_WHATSAPP_CONTACT_URL=https://wa.me/5583991347023?text=Ol%C3%A1%2C%20quero%20conhecer%20o%20EasyAgenda
# Número do financeiro (só dígitos, com DDI) para "Dúvidas financeiras" em Plano e cobrança. Vazio esconde os botões.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Login com Google (fase 7): 1 mostra "Continuar com Google" no login e no cadastro.
NEXT_PUBLIC_GOOGLE_LOGIN_ATIVO=

# Pixel da Meta (anúncios). Conjunto de dados "EasyAgenda+ Site".
# Em produção, sem esta variável, vale o ID 2166081767603206 (definido em next.config.js).
# Defina um ID para trocar de pixel, ou deixe VAZIA para desligar. Fora de produção fica desligado.
# Roda só nas páginas públicas e no cadastro; dispara PageView e CompleteRegistration.
# NEXT_PUBLIC_META_PIXEL_ID=
