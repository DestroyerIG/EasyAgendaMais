# ============================================
# EasyAgenda+ - Backend Environment Variables
# ============================================

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/easyagenda
# Conexão direta usada pelo Prisma Migrate (schema.prisma: directUrl = env("DIRECT_URL")).
# Obrigatória. Local: o mesmo valor de DATABASE_URL. Supabase: a conexão direta ou
# a do Session pooler (porta 5432), nunca a do Transaction pooler (porta 6543).
DIRECT_URL=postgresql://postgres:sua_senha@localhost:5432/easyagenda

# Database Pool (optional)
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=30000

# Database SSL (production)
# DB_CA_CERT=/path/to/ca-certificate.crt

# JWT
JWT_SECRET=
REFRESH_TOKEN_DAYS=30

# Auth provider
# Supabase Auth is mandatory. AUTH_PROVIDER_MODE is deprecated and ignored if present.

# Frontend URL (CORS) — em produção use o domínio oficial (ex: https://barberpro-saas-2-0.vercel.app)
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
VERCEL_PROJECT_PREFIX=barberpro-saas-2-0

# Supabase Auth (identity + email confirmation)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SUPABASE_REDIRECT_TO=http://localhost:3000/auth/confirm
SUPABASE_AUTH_TIMEOUT_MS=12000

# SMTP (opcional): e-mail do convite da profissional. Sem SMTP, a dona copia o link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EasyAgenda+ <no-reply@easyagenda.local>"

# Auth cookies (optional)
# AUTH_COOKIE_DOMAIN=.seudominio.com

# Asaas Billing (cartão e Pix)
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_BILLING_DESCRIPTION=EasyAgenda+ - Plano {plan} ({business})
ASAAS_TIMEOUT_MS=12000

# WhatsApp Provider (Evolution API v2 externa)
WHATSAPP_PROVIDER=evolution

# Base URL of the Evolution API service (no trailing slash). Ex.: https://evolution.onrender.com
EVOLUTION_API_URL=

# Global API key for the Evolution server
EVOLUTION_API_KEY=

# Webhook BASE URL registered on Evolution v2 (createInstance / setWebhook).
#
# CRITICAL RULES:
#   1. This MUST be the backend (Render) URL — NEVER the frontend (Vercel) URL.
#      The frontend has no /api/v1/whatsapp/webhook routes and will 404 every
#      event Evolution dispatches. Do not reuse NEXT_PUBLIC_API_URL or any
#      *.vercel.app host here.
#   2. This is the BASE only. Evolution v2 with webhook_by_events=true appends
#      `/{event-kebab-case}` itself (connection-update, qrcode-updated,
#      messages-upsert, ...). If you include an event suffix here Evolution
#      duplicates it and you get `.../connection-update/connection-update`
#      404s. Code defensively strips accidental suffixes via
#      normalizeWebhookBaseUrl(), but configure it cleanly.
#   3. No trailing slash.
#
# Production example:
#   BACKEND_WEBHOOK_BASE_URL=https://easybarber-backend.onrender.com/api/v1/whatsapp/webhook
#
# BACKEND_WEBHOOK_BASE_URL is the preferred name. EVOLUTION_WEBHOOK_URL is
# kept as a legacy alias and used as fallback when the new name is empty.
BACKEND_WEBHOOK_BASE_URL=
EVOLUTION_WEBHOOK_URL=

# DEV/TEST ONLY — leave empty in production. Multi-tenant tenants resolve their
# own instanceName from businesses.whatsapp_instance_name (UNIQUE per tenant).
# If set, this acts as a fallback for non-tenant-scoped legacy code paths only.
EVOLUTION_INSTANCE_NAME=

# DEPRECATED — see DEPLOY.md. Fonte de verdade: businesses.whatsapp_instance_name.
# Mantido apenas como ponte para fluxos legados (testes/migração).
# Ex.: {"easyagenda":"<business_uuid>"}  ou  easyagenda=<business_uuid>
WHATSAPP_INSTANCE_BUSINESS_MAP=

# DEV/TEST ONLY — leave empty in production. UUID do negócio usado como último
# recurso quando o bot não consegue resolver o negócio pela instância, pelo mapa
# acima ou pela sessão ativa.
WHATSAPP_DEFAULT_BUSINESS_ID=

EVOLUTION_API_TIMEOUT_MS=10000
WHATSAPP_SESSION_TIMEOUT_MS=1800000

# Fuso das rotinas (lembretes, automações, fila). O servidor roda em UTC e os
# agendamentos gravam o relógio local do negócio. Padrão: America/Sao_Paulo.
BUSINESS_TIMEZONE=America/Sao_Paulo

# Notificações push (Web Push). Gere uma vez com `npx web-push generate-vapid-keys`
# e não troque depois: trocar invalida as inscrições. Vazio esconde "Ativar notificações".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@seudominio.com

# Google Agenda (fase 7). Passo a passo em docs/google-configuracao.md.
# Vazio esconde o cartão do Google Agenda.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Igual ao URI cadastrado no Google Cloud.
GOOGLE_AGENDA_REDIRECT_URI=http://localhost:5000/api/v1/google-agenda/callback
# 32 bytes em base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Não troque depois: trocar invalida as conexões existentes.
GOOGLE_TOKEN_KEY=

# Recebimentos automáticos do sinal (Mercado Pago). Vazio esconde Recebimentos nas telas.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Igual ao URI cadastrado no aplicativo do Mercado Pago.
MERCADOPAGO_REDIRECT_URI=http://localhost:5000/api/v1/recebimentos/mercadopago/callback
# 32 bytes em base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Não troque depois: trocar invalida as conexões existentes.
RECEBIMENTOS_TOKEN_KEY=

# Observabilidade (opcional)
OTEL_ENABLED=false
