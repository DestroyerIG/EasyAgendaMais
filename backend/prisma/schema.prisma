  preco               Decimal  @db.Decimal(10, 2)
  sessoesPorCiclo     Int?     @map("sessoes_por_ciclo")
  sessoesReferencia   Int      @default(4) @map("sessoes_referencia")
  intervaloMinimoDias Int      @default(0) @map("intervalo_minimo_dias")
  totalSessoes        Int?     @map("total_sessoes")
  validadeDias        Int?     @map("validade_dias")
  faltaDebita         Boolean  @default(false) @map("falta_debita")
  descontoExtrasPct   Decimal  @default(0) @map("desconto_extras_pct") @db.Decimal(5, 2)
  beneficios          String[] @default([])
  publica             Boolean  @default(false)
  status              String   @default("ativa") @db.VarChar(12)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business      Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  servicos      ClubeOfertaServico[]
  profissionais ClubeOfertaProfissional[]
  contratos     ClubeContrato[]

  @@index([businessId, status])
  @@map("clube_ofertas")
}

model ClubeOfertaServico {
  ofertaId  String @map("oferta_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  oferta  ClubeOferta @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  service Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([ofertaId, serviceId])
  @@map("clube_oferta_servicos")
}

model ClubeOfertaProfissional {
  ofertaId       String @map("oferta_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid

  oferta       ClubeOferta  @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([ofertaId, professionalId])
  @@map("clube_oferta_profissionais")
}

model ClubeContrato {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId          String    @map("business_id") @db.Uuid
  ofertaId            String    @map("oferta_id") @db.Uuid
  clientId            String    @map("client_id") @db.Uuid
  tipo                String    @db.VarChar(10)
  status              String    @db.VarChar(24)
  origem              String    @default("painel") @db.VarChar(10)
  preco               Decimal   @db.Decimal(10, 2)
  valorSessao         Decimal   @map("valor_sessao") @db.Decimal(10, 2)
  sessoesPorCiclo     Int?      @map("sessoes_por_ciclo")
  intervaloMinimoDias Int       @default(0) @map("intervalo_minimo_dias")
  totalSessoes        Int?      @map("total_sessoes")
  sessoesUsadas       Int       @default(0) @map("sessoes_usadas")
  validadeDias        Int?      @map("validade_dias")
  ativadoEm           DateTime? @map("ativado_em") @db.Date
  cicloInicio         DateTime? @map("ciclo_inicio") @db.Date
  cicloFim            DateTime? @map("ciclo_fim") @db.Date
  validoAte           DateTime? @map("valido_ate") @db.Date
  canceladoEm         DateTime? @map("cancelado_em") @db.Timestamptz(6)
  cancelaEm           DateTime? @map("cancela_em") @db.Date
  createdBy           String?   @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  oferta       ClubeOferta     @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  client       Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cobrancas    ClubeCobranca[]
  usos         ClubeUso[]
  comandaItems ComandaItem[]

  @@index([businessId, status])
  @@index([businessId, clientId])
  @@index([ofertaId])
  @@map("clube_contratos")
}

model ClubeCobranca {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String    @map("business_id") @db.Uuid
  contratoId    String    @map("contrato_id") @db.Uuid
  competencia   DateTime  @db.Date
  valor         Decimal   @db.Decimal(10, 2)
  vencimento    DateTime  @db.Date
  status        String    @default("pendente") @db.VarChar(12)
  pixCopiaCola  String?   @map("pix_copia_cola") @db.Text
  forma         String?   @db.VarChar(20)
  pagoEm        DateTime? @map("pago_em") @db.Timestamptz(6)
  confirmadoPor String?   @map("confirmado_por") @db.Uuid
  cashSessionId String?   @map("cash_session_id") @db.Uuid
  enviadoEm     DateTime? @map("enviado_em") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  contrato ClubeContrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, competencia])
  @@index([businessId, status, vencimento])
  @@index([businessId, pagoEm])
  @@index([cashSessionId])
  @@map("clube_cobrancas")
}

model ClubeUso {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  contratoId    String   @map("contrato_id") @db.Uuid
  comandaItemId String?  @unique @map("comanda_item_id") @db.Uuid
  appointmentId String?  @map("appointment_id") @db.Uuid
  serviceId     String?  @map("service_id") @db.Uuid
  data          DateTime @db.Date
  valorSessao   Decimal  @map("valor_sessao") @db.Decimal(10, 2)
  motivo        String   @default("atendimento") @db.VarChar(12)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  contrato ClubeContrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, appointmentId])
  @@index([contratoId, data])
  @@map("clube_usos")
}

// ─── App da profissional (fase 5) ────────────────────────────────────────────

model ProfissionalConvite {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  professionalId String    @map("professional_id") @db.Uuid
  email          String    @db.VarChar(255)
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  expiraEm       DateTime  @map("expira_em")
  aceitoEm       DateTime? @map("aceito_em")
  revogadoEm     DateTime? @map("revogado_em")
  criadoPor      String?   @map("criado_por") @db.Uuid
  criadoEm       DateTime  @default(now()) @map("criado_em")

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  criadoPorUser User?       @relation("ConviteCriadoPor", fields: [criadoPor], references: [id], onDelete: SetNull)

  @@index([businessId, professionalId])
  @@map("profissional_convites")
}

model PushInscricao {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  endpoint     String    @unique @db.Text
  p256dh       String    @db.VarChar(255)
  auth         String    @db.VarChar(255)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  criadoEm     DateTime  @default(now()) @map("criado_em")
  ultimoErroEm DateTime? @map("ultimo_erro_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_inscricoes")
}

// Google Agenda (fase 7). Uma conexão por usuário; a do negócio é única por negócio (índice parcial na migração).
model GoogleAgendaConexao {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId          String    @map("business_id") @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  /// negocio | profissional
  tipo                String    @db.VarChar(15)
  /// A pessoa da grade cujo ocupado bloqueia horário (nulo: a dona não atende).
  professionalId      String?   @map("professional_id") @db.Uuid
  googleEmail         String    @map("google_email") @db.VarChar(255)
  refreshTokenCifrado String    @map("refresh_token_cifrado") @db.Text
  calendarioId        String    @map("calendario_id") @db.VarChar(255)
  /// ativa | reconectar ("pausada pelo plano" é calculado, não gravado)
  status              String    @default("ativa") @db.VarChar(15)
  ultimoErro          String?   @map("ultimo_erro") @db.VarChar(255)
  ultimaSyncEm        DateTime? @map("ultima_sync_em")
  criadaEm            DateTime  @default(now()) @map("criada_em")

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  professional Professional?         @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  eventos      GoogleAgendaEvento[]
  ocupados     GoogleAgendaOcupado[]

  @@index([businessId])
  @@map("google_agenda_conexoes")
}

model GoogleAgendaEvento {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conexaoId     String   @map("conexao_id") @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  googleEventId String   @map("google_event_id") @db.VarChar(255)
  /// O updated_at do agendamento na última gravação no Google.
  versao        DateTime

  conexao     GoogleAgendaConexao @relation(fields: [conexaoId], references: [id], onDelete: Cascade)
  appointment Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([conexaoId, appointmentId])
  @@map("google_agenda_eventos")
}

model GoogleAgendaOcupado {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conexaoId String   @map("conexao_id") @db.Uuid
  inicio    DateTime @db.Timestamptz(6)
  fim       DateTime @db.Timestamptz(6)

  conexao GoogleAgendaConexao @relation(fields: [conexaoId], references: [id], onDelete: Cascade)

  @@index([conexaoId, inicio])
  @@map("google_agenda_ocupado")
}
